# Python-generated files (linux/). Build outputs are anchored so they cannot hide a windows/
# directory of the same name.
__pycache__/
*.py[oc]
/linux/build/
/linux/dist/
/linux/wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/

# .NET build outputs and IDE state (windows/)
bin/
obj/
.vs/
*.user
TestResults/
