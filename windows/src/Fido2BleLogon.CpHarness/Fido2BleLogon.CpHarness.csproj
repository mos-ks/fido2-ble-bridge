<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Raw vtable calls into the provider and the fake LogonUI objects use function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- The provider grants InternalsVisibleTo to this name (offline self-test hooks). -->
    <AssemblyName>fido2-ble-logon-cphost</AssemblyName>
    <RootNamespace>Fido2BleLogon.CpHarness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2BleLogon.CredentialProvider\Fido2BleLogon.CredentialProvider.csproj" />
    <ProjectReference Include="..\Fido2BleLogon.Core\Fido2BleLogon.Core.csproj" />
  </ItemGroup>

</Project>
