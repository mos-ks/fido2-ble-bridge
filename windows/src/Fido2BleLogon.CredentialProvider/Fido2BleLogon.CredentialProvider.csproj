<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match Fido2BleLogon.Core (CsWinRT projections for the BLE transport). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fido2BleLogon.CredentialProvider</RootNamespace>

    <!-- x64 only: LogonUI is x64 and the interop sizes/offsets assume 8-byte pointers. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- The message-only window's WndProc is an [UnmanagedCallersOnly] function pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Build the native *.comhost.dll that regsvr32 registers (the CLSID -> .NET type map is
         embedded in it). Framework-dependent only; LogonUI finds the shared runtime machine-wide. -->
    <EnableComHosting>true</EnableComHosting>

    <!-- Built-in COM interop (classic CCW/RCW); no trimming, no Native AOT. -->
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>

    <!-- Defense in depth for hosts that inherit a user's environment: ignore DOTNET_STARTUP_HOOKS. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Load WinRT.Runtime and the CsWinRT projections (pulled in via Core's BLE transport) into the
         default AssemblyLoadContext instead of comhost's per-component ALC. Documented lever for the
         "CsWinRT in a plugin ALC" hazard. Ends up in the comhost's runtimeconfig.json. -->
    <RuntimeHostConfigurationOption
      Include="System.Runtime.InteropServices.COM.LoadComponentInDefaultContext" Value="true" Trim="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The LogonUI simulation harness drives the offline self-test through TestHooks. -->
    <InternalsVisibleTo Include="fido2-ble-logon-cphost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fido2BleLogon.Core\Fido2BleLogon.Core.csproj" />
  </ItemGroup>

</Project>
