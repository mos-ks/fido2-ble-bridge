Name: FIDO2 key over Bluetooth for local logins (pam_u2f + fido2-ble-bridge)
Default: no
Priority: 300
Auth-Type: Primary
Auth:
	[success=ignore default=4]	pam_succeed_if.so quiet service in gdm-password:sudo:sudo-i:login:sddm:kde:lightdm:xscreensaver:cinnamon-screensaver:mate-screensaver:xfce4-screensaver:swaylock:hyprlock:i3lock
	[success=1 default=ignore]	pam_succeed_if.so quiet service in gdm-password:sddm:kde:lightdm:xscreensaver:cinnamon-screensaver:mate-screensaver:xfce4-screensaver:swaylock:hyprlock:i3lock
	[success=ignore default=2]	pam_exec.so quiet /opt/fido2-ble-bridge/bin/python -I -m fido2_ble_bridge.local_session
	[default=ignore]	pam_exec.so quiet stdout /usr/bin/echo Bluetooth key: press its button, then touch the sensor when it lights up. No key? Wait for the password prompt.
	[success=end default=ignore]	pam_u2f.so authfile=/etc/fido2-ble-bridge/u2f_mappings origin=pam://fido2-ble-bridge cue userverification=1
Auth-Initial:
	[success=ignore default=4]	pam_succeed_if.so quiet service in gdm-password:sudo:sudo-i:login:sddm:kde:lightdm:xscreensaver:cinnamon-screensaver:mate-screensaver:xfce4-screensaver:swaylock:hyprlock:i3lock
	[success=1 default=ignore]	pam_succeed_if.so quiet service in gdm-password:sddm:kde:lightdm:xscreensaver:cinnamon-screensaver:mate-screensaver:xfce4-screensaver:swaylock:hyprlock:i3lock
	[success=ignore default=2]	pam_exec.so quiet /opt/fido2-ble-bridge/bin/python -I -m fido2_ble_bridge.local_session
	[default=ignore]	pam_exec.so quiet stdout /usr/bin/echo Bluetooth key: press its button, then touch the sensor when it lights up. No key? Wait for the password prompt.
	[success=end default=ignore]	pam_u2f.so authfile=/etc/fido2-ble-bridge/u2f_mappings origin=pam://fido2-ble-bridge cue userverification=1
