# fido2-ble-bridge configuration (/etc/fido2-ble-bridge/config.toml)

# Bluetooth address of your bonded key, as shown by `bluetoothctl devices`.
# The bridge refuses to talk to anything else, and to this address unless BlueZ has a bond.
address = "AA:BB:CC:DD:EE:FF"

# Bluetooth adapter, if you have more than one.
# adapter = "hci0"

# Seconds a login waits for the key to wake up and connect before falling back to your
# password. Lower it if you often log in without the key nearby.
connect_timeout = 10

# Seconds the Bluetooth link stays open after the last request, so the several requests of
# one login share a connection. The key may disconnect sooner on its own to save battery.
idle_disconnect = 10

# Name of the virtual HID device (shows up in `fido2-token -L` and udev).
# device_name = "FIDO2 BLE bridge"
